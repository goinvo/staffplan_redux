<% inactive = @user.inactive?(company: current_company) %>
<%= render Timeline::GridComponent.new(window: @window, hours: @hours, extra_controller: ("add-project" unless inactive)) do |grid| %>
  <% grid.with_page_header do %>
    <%= render Timeline::PageHeaderComponent.new(
      title: @user.name,
      avatar_url: AvatarHelper.new(target: @user).image_url,
      inactive:,
      edit_path: (settings_profile_path if @own_page),
    ) %>
  <% end %>
  <% grid.with_mobile_header do %>
    <span class="pr-2 font-bold text-2xl text-left break-words leading-snug"><%= @user.name %></span>
    <% if @own_page %>
      <%= link_to settings_profile_path, class: "py-1 px-2", aria: { label: "Edit profile" } do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z"/></svg>
      <% end %>
    <% end %>
  <% end %>
  <% grid.with_columns do %>
    <%= render Timeline::SortColumnsComponent.new(sort: @sort, columns: Timeline::SortColumnsComponent::MY_STAFFPLAN, add: (Timeline::SortColumnsComponent::ADD_PROJECT unless inactive)) %>
  <% end %>
  <%= render People::AddProjectRowComponent.new(user: @user, company: current_company) unless inactive %>
  <% @assignments.each_with_index do |assignment, index| %>
    <%= render People::AssignmentRowComponent.new(
      assignment:,
      window: @window,
      hours: @hours,
      sort: @sort,
      index:,
      first_client: @assignments.index { it.project.client_id == assignment.project.client_id } == index,
      viewer: current_user,
      manager: manager?,
      show_hidden: @show_hidden,
      inactive:,
      highlight: flash[:highlight] == assignment.id,
    ) %>
  <% end %>
  <%= render People::HiddenAssignmentsComponent.new(count: @hidden_assignments.size, hours: @hidden_hours, window: @window, show_hidden: @show_hidden) %>
  <%= render People::MobileFooterComponent.new(hours: @hours, approve_path: (person_approval_path(@user) if @own_page && !inactive)) %>
<% end %>
