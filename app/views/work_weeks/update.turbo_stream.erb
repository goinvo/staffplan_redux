<%= turbo_stream.replace @work_week.dom_id, method: :morph do %>
  <%= render StaffPlan::WorkWeekComponent.new(work_week: @work_week, errors: @work_week.errors.full_messages) %>
<% end %>
<%= turbo_stream.replace dom_id(@work_week.assignment, 'totals'), method: :morph do %>
  <%= render StaffPlan::AssignmentTotalsComponent.new(assignment: @work_week.assignment) %>
<% end %>
<%= turbo_stream.replace dom_id(@work_week.user, 'header'), method: :morph do %>
  <%= render StaffPlan::HeaderChartComponent.new(user: @work_week.user) %>
<% end %>
