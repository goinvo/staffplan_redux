<nav aria-label="Main" class="navbar pl-6 pr-0 sm:px-5 h-14 flex justify-between items-center">
  <div class="flex items-center pl-1 sm:pl-0 sm:space-x-4 space-x-1 h-full">
    <% main_nav_links.each do |label, path, active| %>
      <%= link_to label, staffplan_ui_url(path),
            class: ['inline-flex items-center text-base sm:px-4 px-1 sm:py-2 py-1 rounded-md whitespace-nowrap',
                    active ? 'bg-contrastBlue' : 'hover:bg-contrastBlue'],
            aria: { current: ('page' if active) } %>
    <% end %>
    <% if rails_ui? %>
      <button type="button" class="px-8" aria-label="New project" data-action="shortcuts#newProject">
        <div class="flex self-start py-0.5">
          <svg class="sm:block hidden h-8 w-8 rounded-md text-contrastGrey hover:text-white" fill="currentColor" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V96c0-35.3-28.7-64-64-64H64zM200 344V280H136c-13.3 0-24-10.7-24-24s10.7-24 24-24h64V168c0-13.3 10.7-24 24-24s24 10.7 24 24v64h64c13.3 0 24 10.7 24 24s-10.7 24-24 24H248v64c0 13.3-10.7 24-24 24s-24-10.7-24-24z"/>
          </svg>
        </div>
      </button>
    <% end %>
  </div>
  <div class="flex items-center sm:space-x-4 py-4 sm:ml-2">
    <%= link_to 'Feedback', ApplicationHelper::FEEDBACK_MAILTO, target: '_blank', rel: 'noopener noreferrer',
          class: 'sm:inline-flex hidden items-center text-base px-4 py-2 rounded-md hover:bg-contrastBlue' %>
    <div class="relative inline-block text-left" data-controller="dropdown" data-action="click@window->dropdown#hide">
      <button type="button" aria-label="Menu" data-dropdown-target="button" data-action="dropdown#toggle"
              class="cursor-pointer flex items-center text-2xl text-contrastGrey hover:text-white rounded-full ellipsismenu focus:outline-none"></button>
      <div data-dropdown-target="menu" role="menu"
           data-transition-enter="transition ease-out duration-100" data-transition-enter-from="transform opacity-0 scale-95" data-transition-enter-to="transform opacity-100 scale-100"
           data-transition-leave="transition ease-in duration-75" data-transition-leave-from="transform opacity-100 scale-100" data-transition-leave-to="transform opacity-0 scale-95"
           class="hidden absolute right-0 mt-2 w-48 origin-top-right bg-white divide-y divide-gray-100 rounded-md shadow-[0_4px_4px_0_rgba(0,0,0,0.25)] focus:outline-none z-20">
        <div class="py-1 text-sm text-gray-900">
          <%= link_to 'Open Source', ApplicationHelper::OPEN_SOURCE_URL, target: '_blank', rel: 'noopener noreferrer', role: 'menuitem', class: 'px-4 py-2 block hover:text-tiffany' %>
          <%= link_to 'Settings', settings_profile_path, role: 'menuitem', class: 'px-4 py-2 block hover:text-tiffany' %>
          <%= button_to 'Sign Out', auth_sign_out_path, method: :delete, role: 'menuitem', class: 'px-4 py-2 block w-full text-left hover:text-tiffany cursor-pointer' %>
        </div>
      </div>
    </div>
  </div>
</nav>
