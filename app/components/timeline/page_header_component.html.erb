<div class="flex text-white items-center pr-3">
  <% if avatar_url %>
    <div class="px-2 py-2 relative overflow-hidden w-[92px] h-[67px] aspect-[92/67] mr-4">
      <%= image_tag avatar_url, alt: "Avatar", class: "absolute inset-0 h-full w-full rounded-lg object-cover" %>
    </div>
  <% end %>
  <div class="flex flex-col items-start">
    <div class="flex items-center">
      <h1 class="text-huge text-left font-normal break-words leading-snug">
        <%= title %>
        <% if inactive %>
          <span class="block text-sm leading-[14px] font-normal">(Deactivated)</span>
        <% end %>
      </h1>
      <% if edit_path %>
        <%= link_to edit_path, class: "py-1 pl-4", aria: { label: "Edit profile" } do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z"/></svg>
        <% end %>
      <% end %>
    </div>
    <%= content %>
  </div>
</div>
