<div class="flex items-center text-start">
  <% if add_people %>
    <%= link_to helpers.settings_users_path, class: "mr-1 -translate-x-0.5", aria: { label: "Add people" } do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
    <% end %>
  <% end %>
  <%= link_to sort_path, class: "flex items-center justify-start text-start", data: { turbo_action: "replace" } do %>
    <span>People</span>
    <span class="ml-1 mr-[2px]">(<%= sort.label %>)</span>
    <span class="sr-only">(sorted <%= sort.desc? ? "descending" : "ascending" %>)</span>
    <svg class="w-4 h-4 transform <%= sort.desc? ? "rotate-90" : "-rotate-90" %> [transition:transform_0.3s_ease-in-out,opacity_0.2s_ease-in-out]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
  <% end %>
</div>
