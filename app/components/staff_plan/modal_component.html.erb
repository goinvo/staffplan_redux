<div
  data-controller="modal"
  class="<%= @show ? '' : 'hidden' %> fixed inset-0 z-50"
  role="dialog"
  aria-modal="true"
  aria-labelledby="<%= @title ? 'modal-title' : nil %>"
>
  <div
    data-modal-target="backdrop"
    class="fixed inset-0 bg-black bg-opacity-30"
  ></div>

  <div
    class="fixed inset-0 flex items-center justify-center p-4"
    data-action="click->modal#closeOnBackdrop"
  >
    <div
      data-modal-target="dialog"
      class="timeline-grid-bg rounded-2xl p-4 text-contrastBlue max-w-md mx-auto relative"
      tabindex="-1"
    >
      <% if @title %>
        <h2 id="modal-title" class="text-xl font-bold mb-4"><%= @title %></h2>
      <% end %>

      <%= content %>
    </div>
  </div>
</div>
