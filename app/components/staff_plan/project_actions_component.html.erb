<div
  data-menu-target="menu"
  class="hidden absolute left-full top-0 ml-2.5 w-56 origin-top-left bg-white rounded-md shadow-[0_4px_4px_0_rgba(0,0,0,0.25)] focus:outline-none z-50"
  role="menu"
  aria-orientation="vertical"
  tabindex="-1"
>
  <div class="py-1" role="none">
    <%= link_to "Edit project", edit_project_path(assignment.project), data: { turbo_stream: true }, class: "block w-full px-4 py-2 text-sm text-left text-gray-900 hover:bg-gray-100 cursor-pointer" %>
    <button
      class="block w-full px-4 py-2 text-sm text-left text-gray-900 hover:bg-gray-100 cursor-pointer"
      role="menuitem"
      tabindex="-1"
    >
      Hide in My StaffPlan
    </button>
    <button
      class="block w-full px-4 py-2 text-sm text-left text-gray-900 hover:bg-gray-100 cursor-pointer"
      role="menuitem"
      tabindex="-1"
    >
      Export CSV
    </button>
    <button
      class="block w-full px-4 py-2 text-sm text-left text-[#FF5E5E] hover:bg-gray-100 border-t border-[#E5E7EB] cursor-pointer"
      role="menuitem"
      tabindex="-1"
    >
      Archive project for everyone
    </button>
  </div>
</div>
